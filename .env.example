# Keep credentials in .env or hosting environment settings, never in Git.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-server-only-service-key
FRONTEND_URL=http://localhost:3000
# Shared secret between the Next.js server and this backend. Required: without it
# every /api route except /api/health returns 503. Set the SAME value as
# BACKEND_API_KEY in the frontend's server environment (never NEXT_PUBLIC_).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=replace-with-a-long-random-secret
